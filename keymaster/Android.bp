cc_binary {
    name: "keystore_tuna_auth_probe",
    vendor: false,
    srcs: ["keystore_tuna_auth_probe.cpp"],
    cpp_std: "c++17",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    defaults: [
        "keymint_use_latest_hal_aidl_ndk_shared",
        "keystore2_use_latest_aidl_ndk_shared",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libkeymint_support",
    ],
}
