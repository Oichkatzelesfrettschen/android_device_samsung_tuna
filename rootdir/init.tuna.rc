import /vendor/etc/init/hw/init.omap4.rc
import /vendor/etc/init/hw/init.tuna.usb.rc

on early-init
    mount debugfs /sys/kernel/debug /sys/kernel/debug

on init
    # KSM
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/sleep_millisecs 500
    write /sys/kernel/mm/ksm/run 1

on fs
    mkdir /factory 0775 radio radio
    mkdir /tee 0770 drmrpc drmrpc
    write /sys/block/zram0/comp_algorithm lz4
    mount_all /vendor/etc/fstab.tuna
    swapon_all /vendor/etc/fstab.tuna
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/swappiness 100

    restorecon /dev/block/platform/omap/omap_hsmmc.0/by-name/radio

    # /factory holds the IMEI, NV data and calibration. It mounts read-only
    # and is writable only for the relabel.
    mount ext4 /dev/block/platform/omap/omap_hsmmc.0/by-name/efs /factory rw remount
    restorecon_recursive /factory
    mount ext4 /dev/block/platform/omap/omap_hsmmc.0/by-name/efs /factory ro remount

    start tee_fs_setup

on post-fs-data
    # camera calibration
    mkdir /data/misc/cameraserver/R5_MVEN003_LD2_ND0_IR0_SH0_FL1_SVEN003_DCCID1044 0700 cameraserver cameraserver
    # dumpdcc reads the camera module flash over i2c-2. The first Ducati
    # I2C resource request disables the MPU's i2c-2 IRQ
    # (rprm_i2c_request -> i2c_detect_ext_master), so dumpdcc completes
    # here, before class hal starts the camera provider.
    exec_start dumpdcc

    mkdir /data/radio 0775 radio radio
    mkdir /data/radio/log 0775 radio radio

    # The RIL blob reads the telephony provider database from the pre-N
    # credential-protected path; the symlink is recreated after boot.
    rm /data/data/com.android.providers.telephony/databases

    # Set indication (checked by vold) that this action has finished
    setprop vold.post_fs_data_done 1

on early-boot
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864

on boot
    # autosuspend root hubs immediately after attached devices
    write /sys/bus/usb/devices/usb1/power/autosuspend_delay_ms 0
    write /sys/bus/usb/devices/usb2/power/autosuspend_delay_ms 0

    # The RIL reads the boot variant from the kernel command line
    chmod 0644 /proc/cmdline

    # LTE and USB/UART switch
    chown radio system /sys/devices/tuna_otg/usb_sel
    chown radio system /sys/devices/tuna_otg/uart_sel
    chown radio system /sys/bus/i2c/drivers/fsa9480/4-0025/switch
    chmod 0660 /sys/bus/i2c/drivers/fsa9480/4-0025/switch
    chmod 0660 /sys/devices/tuna_otg/uart_sel
    chmod 0660 /sys/devices/tuna_otg/usb_sel

    # Bluetooth
    setprop ro.bt.bdaddr_path "/factory/bluetooth/bt_addr"
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type

    # Backlight
    chown system system /sys/class/backlight/s6e8aa0/brightness

    # GPS
    chown root system /sys/class/sec/gps/GPS_PWR_EN/value
    chmod 0660 /sys/class/sec/gps/GPS_PWR_EN/value
    chown root system /sys/class/sec/gps/GPS_nRST/value
    chmod 0660 /sys/class/sec/gps/GPS_nRST/value
    chown system system /proc/mcspi1_cs3_ctrl
    chmod 0600 /proc/mcspi1_cs3_ctrl

    # RIL control of USB auto-suspend
    chmod 0660 /sys/bus/usb/devices/usb1/power/control
    chown radio radio /sys/bus/usb/devices/usb1/power/control

on property:persist.sys.tuna.off_mode=*
    write /sys/kernel/debug/pm_debug/enable_off_mode ${persist.sys.tuna.off_mode}

on property:ril.modem.lte.powercontrol=*
    write /sys/bus/usb/devices/1-1/power/control ${ril.modem.lte.powercontrol}

on property:sys.boot_completed=1
    # The RIL blob reads telephony.db through the pre-N path
    symlink /data/user_de/0/com.android.providers.telephony/databases /data/data/com.android.providers.telephony/databases

    # BFQ I/O scheduler after boot
    setprop sys.io.scheduler "bfq"

service dumpdcc /vendor/bin/dumpdcc
    user cameraserver
    group cameraserver
    disabled
    oneshot

service tf_daemon /vendor/bin/tf_daemon -d -c /vendor/etc/smc_normal_world_android_cfg.ini
    class core
    user drmrpc
    group drmrpc
    disabled

service smc_pa_wvdrm /vendor/bin/smc_pa_ctrl -c /vendor/etc/smc_normal_world_android_cfg.ini start /vendor/firmware/smc_pa_wvdrm.ift
    class core
    user drmrpc
    group drmrpc
    oneshot
    disabled

# Checks, and on first boot formats, the dgs partition behind /tee.
service tee_fs_setup /vendor/bin/tee-fs-setup.sh
    class core
    user root
    group root drmrpc
    disabled
    oneshot

on property:vendor.tee_fs.ready=true
    start smc_pa_wvdrm
    start tf_daemon

# A freshly formatted dgs gets its smc directory, then the device reboots:
# tf_daemon hangs when started on a filesystem created in the same boot.
on property:vendor.tee_fs.formatted=true
    mount ext4 /dev/block/platform/omap/omap_hsmmc.0/by-name/dgs /tee noatime nosuid nodev
    mkdir /tee/smc 0770 drmrpc drmrpc
    restorecon_recursive /tee
    setprop sys.powerctl reboot,tee-fs-setup

# Allow writing to the kernel trace log. Enabling tracing still requires root.
on property:ro.debuggable=1
    chmod 0222 /sys/kernel/debug/tracing/trace_marker
