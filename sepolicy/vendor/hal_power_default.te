# The power HAL boosts the MPU through the interactive governor, opens a GPU
# boost window and screen-off cap through sgxfreq, and holds a cpuidle PM QoS
# request on /dev/cpu_dma_latency for the length of a boost.
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default sysfs_sgxfreq:dir search;
allow hal_power_default sysfs_sgxfreq:file rw_file_perms;
allow hal_power_default cpu_dma_latency_device:chr_file rw_file_perms;
